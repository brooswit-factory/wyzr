{
  "name": "@brooswit/wyzr",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A TypeScript library, plus a CLI over it, for Wyze devices: list devices, read a smart plug's status, and turn a plug on and off.",
  "bin": {
    "wyzr": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "bun test test/unit",
    "test:coverage": "bun test --coverage test/unit",
    "check:no-console": "bun run scripts/check-no-console.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.7.0"
  }
}
